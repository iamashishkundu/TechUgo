    {
      "name": "4. Checkout Engine (ACID Transactions)",
      "item": [
        {
          "name": "1. Successful Checkout (Saves orderId)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"items\": [\n    {\n      \"productId\": \"{{inStockProductId}}\",\n      \"quantity\": 2\n    },\n    {\n      \"productId\": \"{{limitedStockProductId}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "checkout"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.test('Order created with items & total', () => {",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.data.orderId).to.be.a('string');",
                  "    pm.expect(res.data.status).to.eql('PENDING');",
                  "    pm.expect(res.data.items.length).to.eql(2);",
                  "    pm.expect(res.data.items[0].title).to.be.a('string');",
                  "});",
                  "// Auto-save generated orderId for subsequent Orders module tests",
                  "pm.collectionVariables.set('orderId', res.data.orderId);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2. Insufficient Stock (Rollback Test -> 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"items\": [\n    {\n      \"productId\": \"{{inStockProductId}}\",\n      \"quantity\": 1\n    },\n    {\n      \"productId\": \"{{outOfStockProductId}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "checkout"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('Error code is INSUFFICIENT_STOCK', () => {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.error).to.eql('INSUFFICIENT_STOCK');",
                  "    pm.expect(res.message).to.include('Insufficient stock');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3. Checkout Inactive Product (Rejection -> 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"items\": [\n    {\n      \"productId\": \"{{inactiveProductId}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "checkout"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Reports inactive product', () => {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.message).to.include('inactive');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
