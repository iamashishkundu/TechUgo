          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Error message mentions quantity > 0', () => {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.message).to.include('greater than 0');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "7. Validation: Duplicate Product IDs in Payload (-> 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"items\": [\n    {\n      \"productId\": \"{{inStockProductId}}\",\n      \"quantity\": 1\n    },\n    {\n      \"productId\": \"{{inStockProductId}}\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "checkout"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Detects duplicate product id', () => {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.message).to.include('Duplicate productId');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "8. Concurrency Test Item Purchase (Buy Last Stock = 1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"items\": [\n    {\n      \"productId\": \"{{singleStockProductId}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "checkout"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// First purchase consumes stock 1 -> 0 (201 Created)",
                  "// Immediate repeat purchase returns 409 Conflict (Insufficent Stock)",
                  "pm.test('Handled with expected status (201 on first run, 409 on subsequent run)', () => {",
                  "    pm.expect([201, 409]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
